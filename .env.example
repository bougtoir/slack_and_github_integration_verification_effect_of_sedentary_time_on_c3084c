# API keys
OPENALEX_API_KEY=your_openalex_key
DEEPSEEK_API_KEY=your_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPL_API_KEY=your_deepl_key
PERPLEXITY_API_KEY=your_perplexity_key
PERPLEXITY_BASE_URL=https://api.perplexity.ai
# Leave empty to use a preset instead
PERPLEXITY_MODEL=
PERPLEXITY_PRESET=pro-search
PERPLEXITY_MAX_STEPS=3
PUBMED_EMAIL=your_email@example.com

# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Optional: Slack Bot Token for per-repo channel creation (scopes: channels:manage, chat:write)
SLACK_BOT_TOKEN=xoxb-...

# GitHub
# Optional: PAT with public_repo/repo scope for auto-creating public repos
GITHUB_REPO_CREATE_TOKEN=ghp_...

# Git behavior
GIT_AUTO_COMMIT=true
GIT_USER_NAME="Paper Sandbox"
GIT_USER_EMAIL="sandbox@example.com"

# Pipeline options
LANGUAGE=en
FIGURE_EMBEDDED=false
